import("//build/config/win/visual_studio_version.gni")

if (is_mingw) {
  # No MSVC toolchain on MinGW: empty data for code that reads it.
  _mingw_toolchain_data = {
    include_flags_I_list = []
    include_flags_imsvc = ""
    include_flags_imsvc_list = []
    libpath_lldlink_flags = ""
    msvc_dir = ""
    vc_bin_dir = ""
    windows_kits_dir = ""
  }
  win_toolchain_data_x86 = _mingw_toolchain_data
  win_toolchain_data_x64 = _mingw_toolchain_data
  win_toolchain_data_arm64 = _mingw_toolchain_data
} else {
declare_args() {
  win_toolchain_data_x86 =
      exec_script("//build/toolchain/win/setup_toolchain.py",
                  [
                    visual_studio_path,
                    windows_sdk_path,
                    visual_studio_runtime_dirs,
                    "win",
                    "x86",
                    "environment.x86",
                  ],
                  "scope")

  win_toolchain_data_x64 =
      exec_script("//build/toolchain/win/setup_toolchain.py",
                  [
                    visual_studio_path,
                    windows_sdk_path,
                    visual_studio_runtime_dirs,
                    "win",
                    "x64",
                    "environment.x64",
                  ],
                  "scope")
  if (target_cpu == "arm64" || host_cpu == "arm64") {
    win_toolchain_data_arm64 =
        exec_script("//build/toolchain/win/setup_toolchain.py",
                    [
                      visual_studio_path,
                      windows_sdk_path,
                      visual_studio_runtime_dirs,
                      "win",
                      "arm64",
                      "environment.arm64",
                    ],
                    "scope")
  }
}

}

if (current_cpu == "x86") {
  current_win_toolchain_data = win_toolchain_data_x86
} else if (current_cpu == "x64") {
  current_win_toolchain_data = win_toolchain_data_x64
} else if (current_cpu == "arm64") {
  current_win_toolchain_data = win_toolchain_data_arm64
} else {
  assert(false,
         "Unsupported cpu ${current_cpu}, add it to win_toolchain_data.gni")
}
